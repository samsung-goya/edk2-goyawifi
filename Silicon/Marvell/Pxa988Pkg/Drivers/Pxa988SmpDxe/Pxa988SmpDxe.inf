## @file
#  Brings up the second Cortex-A9 core of the PXA988/PXA986 as a self-test and
#  leaves it waiting for the OS in an ACPI parking-protocol page.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = Pxa988SmpDxe
  FILE_GUID                      = 3c7a9e14-5d02-4b8f-a6e1-7f20b94c8d35
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = Pxa988SmpInitialize

[Sources]
  Pxa988SmpDxe.c
  Cpu1Stub.S

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  Silicon/Marvell/Pxa988Pkg/Pxa988Pkg.dec

[LibraryClasses]
  ArmLib
  BaseMemoryLib
  PrintLib
  CacheMaintenanceLib
  DebugLib
  IoLib
  TimerLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiDriverEntryPoint

[Guids]
  gEfiEventExitBootServicesGuid
  gEfiEndOfDxeEventGroupGuid

[Protocols]
  gPxa988Cpu1ParkingProtocolGuid                ## PRODUCES

[FixedPcd]
  gPxa988TokenSpaceGuid.PcdSecondaryCpuBringup
  gPxa988TokenSpaceGuid.PcdCpu1ParkingProtocol

[Depex]
  TRUE
