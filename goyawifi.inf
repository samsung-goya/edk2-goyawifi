;*********************************************************************************************

[DestinationDirs]

 DefaultDestDir               = 12 ; %windir%\system32\drivers

 

[SourceDisksNames]

 1 = %INSTALL_DISK_STR%



[SourceDisksFiles]

 goyawifi.sys = 1
 mv14sxx97.bin = 1

 

[mv14s6x.copyfiles.NTarm]

 goyawifi.sys
 mv14sxx97.bin



