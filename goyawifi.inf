[Strings]

 MRVL_VER_VENDOR_STR          = "Marvell"

 MRVL_VER_VENDOR_NAME_STR     = "Marvell Semiconductor, Inc."

 MRVL_SD8797_DESC_STR         = "Marvell 88W8777 Wireless-N (SDIO, goyawifi)"

 MRVL_SDIO_DESC_STR           = "Marvell AVASTAR Wireless-N Network Controller (SDIO)"

