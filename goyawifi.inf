 INSTALL_DISK_STR             = "Marvell AVASTAR Wireless-N Software Install Disk"

 RTSTHRESH_STR                = "RTS Threshold"

 FRAGTHRESH_STR               = "Fragmentation Threshold"

 BAND_TO_USE_STR              = "Band to Use"

