;***********************************************************************
; goyawifi.inf - Marvell 88W8777 Wi-Fi (Galaxy Tab 3 Lite SM-T110) for Windows 8.0 RT
; Generated by tools/make-goyawifi-pkg.py from the Surface RT driver INF mwls97w8arm.inf
; 14.62.17215.91 (Marvell); the function is enumerated by goyasdio.sys (SDH2).
;***********************************************************************
;***********************************************************************

;

; mwls97w8arm.inf

;

; Copyright (C) 2011, Marvell International Ltd.  

; All Rights Reserved

;

; Installation script for Marvell AVASTAR Family Wireless Network adapters.

;

;***********************************************************************



[Version]

 DriverVer=03/02/2013,14.62.17215.91

 Signature              = "$Windows NT$"

 Compatible             = 1

 Class                  = Net

 ClassGUID              = {4d36e972-e325-11ce-bfc1-08002be10318}

 Provider               = %MRVL_VER_VENDOR_NAME_STR%

 CatalogFile            = goyawifi.cat

 PnpLockDown            = 1

[ControlFlags]

;Exclude all PNP adapters from user selection

 ExcludeFromSelect      = *



[Manufacturer]

 %MRVL_VER_VENDOR_NAME_STR% = mv14sd_models, NTarm



[mv14sd_models.NTarm]

 %MRVL_SD8797_DESC_STR% = mv14s6x.NTarm, SD\VID_02DF&PID_9131&FN_1
 %MRVL_SD8797_DESC_STR% = mv14s6x.NTarm, SD\VID_02DF&PID_9131



;********************************************************************************

;					ARM Install section for Windows 8

;********************************************************************************

[mv14s6x.NTarm]



 AddReg                 = mv14s6x.reg, mv14s6x.sdio.reg, mv14s6x.common_ndis.reg, mv14x6x.params.reg, mv14x6x.WoWLANparams.reg, mv14x6x.Offloadparams.reg

 CopyFiles              = mv14s6x.copyfiles.NTarm

 Reboot
 
 ; BusType is not required in Win7, this is here just to satisfy ChkINF

 BusType                = 1

 Characteristics        = 0x84  ; NCF_PHYSICAL, NCF_HAS_UI

 *IfType                = 71    ; IF_TYPE_IEEE80211

 *MediaType             = 16    ; NdisMediumNative802_11

 *PhysicalMediaType     = 9     ; NdisPhysicalMediumNative802_11

 

[mv14s6x.NTarm.Services]



 AddService             = %MRVL_SDIO_SERVICE_STR%, 2, mv14s6x.Service.NTarm, mv14s6x.EventLog



[mv14s6x.Service.NTarm]

 DisplayName            = %MRVL_SDIO_SERVICE_STR%

 ServiceType            = 1     ; SERVICE_KERNEL_DRIVER

 StartType              = 3     ; SERVICE_DEMAND_START

 ErrorControl           = 1     ; SERVICE_ERROR_NORMAL

 ServiceBinary          = %12%\goyawifi.sys

; LoadOrderGroup         = NDIS



[mv14s6x.NTarm.HW]





;********************************************************************************

;					Common Install section for Windows 8

;********************************************************************************

[mv14s6x.reg]

 HKR,NDI                ,DeviceID               ,0      ,"SD\VID_02DF&PID_9131"

 HKR,                   ,VendorDesc             ,0      ,%MRVL_SDIO_DESC_STR%

 HKR,                   ,NetworkAddress         ,0      ,""           



[mv14s6x.sdio.reg]

 HKR,NDI                ,Service                ,0      ,%MRVL_SDIO_SERVICE_STR%

 HKR,NDI                ,CardType               ,0      ,"SDIO"

 HKR,                   ,BusType                ,0      ,"0"

 

;*********************************************************************************************

[mv14s6x.EventLog]

 AddReg                 = mv14s6x.EventLog.reg



[mv14s6x.EventLog.reg]

 HKR,                   ,EventMessageFile       ,0x00020000     ,"%%SystemRoot%%\System32\netevent.dll"

 HKR,                   ,TypesSupported         ,0x00010001     ,7



;*********************************************************************************************

[mv14s6x.common_ndis.reg]

HKR,                    ,DevLoader              ,0      ,"*ndis"

HKR,NDI                 ,Service                ,0      ,%MRVL_SDIO_SERVICE_STR%

HKR,NDI\Interfaces      ,UpperRange             ,0      ,"ndis5"

HKR,NDI\Interfaces      ,LowerRange             ,0      ,"ethernet,wlan,vwifi"

HKR,NDIS                ,LogDriverName          ,0      ,%MRVL_SDIO_SERVICE_STR%



[mv14x6x.params.reg]

